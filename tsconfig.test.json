{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "vitest/browser"],
    "paths": {
      "react": ["./frontend/nyanpasu/node_modules/@types/react"],
      "react/*": ["./frontend/nyanpasu/node_modules/@types/react/*"],
      "@/*": ["./frontend/nyanpasu/src/*"],
      "@interface/*": ["./frontend/interface/src/*"],
      "@nyanpasu/interface": ["./frontend/interface/src/index.ts"],
      "@nyanpasu/interface/*": ["./frontend/interface/src/*"],
      "@nyanpasu/utils": ["./frontend/utils/src/index.ts"],
      "@nyanpasu/utils/*": ["./frontend/utils/src/*"],
      "~icons/*": ["./frontend/nyanpasu/tests/icon-stub.tsx"]
    }
  },
  "include": [
    "vitest.config.ts",
    "frontend/nyanpasu/src/services/types.d.ts",
    "frontend/*/tests/**/*.ts",
    "frontend/*/tests/**/*.tsx"
  ]
}
