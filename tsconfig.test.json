{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/browser"],
    "paths": {
      "@interface/*": ["./frontend/interface/src/*"],
      "@nyanpasu/interface": ["./frontend/interface/src/index.ts"],
      "@nyanpasu/interface/*": ["./frontend/interface/src/*"],
      "@nyanpasu/utils": ["./frontend/utils/src/index.ts"],
      "@nyanpasu/utils/*": ["./frontend/utils/src/*"]
    }
  },
  "include": [
    "vitest.config.ts",
    "frontend/*/tests/**/*.ts",
    "frontend/*/tests/**/*.tsx"
  ]
}
