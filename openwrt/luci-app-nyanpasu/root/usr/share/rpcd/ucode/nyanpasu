'use strict';

// Publishes the ubus object `nyanpasu` with one method, `webui_ticket`, which
// asks nyanpasu-server for a one-time ticket that signs a browser in to the
// WebUI. It runs
//
//   nyanpasu-cli call issue_web_ticket --params-file FILE
//
// and wraps the outcome as one of
//
//   { ok: true,  result: { path, port } }               CLI exit 0
//   { ok: false, error: <RpcError> }                    CLI exit 1
//   { ok: false, transport: true, error: { kind: 'transport', message,
//                                          exit_code, outcome_unknown? } }
//                                                       exit 2, a signal, or
//                                                       output that is not JSON
//
// The management of profiles and the core is the WebUI's, over the server's
// HTTP API; LuCI only issues the ticket. The method takes no arguments, and
// nothing a caller sends reaches a command line: the command name is a
// constant and the paths are generated here. The ACL in
// acl.d/luci-app-nyanpasu.json grants the method to `write` only; keep the two
// in step.

import { popen, open, mkdtemp, unlink, rmdir, readfile } from 'fs';

const CLI = '/usr/bin/nyanpasu-cli';

function shellquote(s) {
	return `'${replace(s, "'", "'\\''")}'`;
}

function transport_error(message, exit_code, outcome_unknown) {
	const error = { kind: 'transport', message, exit_code };

	if (outcome_unknown != null)
		error.outcome_unknown = outcome_unknown;

	return { ok: false, transport: true, error };
}

function parse_json(text) {
	const trimmed = trim(text);
	if (trimmed == 'null')
		return { value: null };

	const value = json(trimmed);
	return value == null ? null : { value };
}

function call_cli(command) {
	const dir = mkdtemp('/tmp/nyanpasu-XXXXXX');
	if (!dir)
		return transport_error('cannot create a temporary directory');

	const params_file = `${dir}/params.json`;
	const stderr_file = `${dir}/stderr`;
	let reply;

	const params_handle = open(params_file, 'w', 0600);
	if (!params_handle) {
		reply = transport_error('cannot write the parameters file');
	}
	else {
		params_handle.write('{}');
		params_handle.close();

		// Only constants and generated paths are interpolated here; both are quoted.
		const pipe = popen(`${shellquote(CLI)} call ${shellquote(command)} --params-file ${shellquote(params_file)} 2>${shellquote(stderr_file)}`, 'r');
		if (!pipe) {
			reply = transport_error('cannot run nyanpasu-cli');
		}
		else {
			const stdout = pipe.read('all');
			const code = pipe.close();
			const parsed = (code == 0 || code == 1 || code == 2) ? parse_json(stdout) : null;

			if (code == 0 && parsed)
				reply = { ok: true, result: parsed.value };
			else if (code == 1 && parsed)
				reply = { ok: false, error: parsed.value };
			else if (code == 2 && parsed && type(parsed.value) == 'object' && type(parsed.value.message) == 'string')
				reply = transport_error(parsed.value.message, code, parsed.value.outcome_unknown);
			else {
				const stderr = trim(readfile(stderr_file) ?? '');
				const reason = (code == 0 || code == 1)
					? 'nyanpasu-cli printed output that is not JSON'
					: (stderr || `nyanpasu-cli exited with status ${code}`);
				reply = transport_error(reason, code);
			}
		}
	}

	unlink(params_file);
	unlink(stderr_file);
	rmdir(dir);

	return reply;
}

return {
	nyanpasu: {
		// The ubus method `webui_ticket` runs the server command `issue_web_ticket`.
		webui_ticket: {
			args: {},
			call: function() {
				return call_cli('issue_web_ticket');
			}
		}
	}
};
