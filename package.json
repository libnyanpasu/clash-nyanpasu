{
  "name": "@nyanpasu/monorepo",
  "version": "2.0.0-beta.1",
  "repository": "https://github.com/libnyanpasu/clash-nyanpasu.git",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "run-p tauri:dev",
    "dev:diff": "run-p tauri:diff",
    "build": "tauri build",
    "build:packages": "pnpm -r --filter './frontend/*' --filter '!@nyanpasu/nyanpasu' typecheck",
    "build:release": "run-s build:packages build",
    "build:debug": "tauri build -f verge-dev deadlock-detection -d -c \"{ \\\"tauri\\\" : { \\\"updater\\\": { \\\"active\\\": false } }} \"",
    "build:nightly": "tauri build -f nightly -c ./backend/tauri/tauri.nightly.conf.json",
    "tauri": "tauri",
    "tauri:dev": "tauri dev -c ./backend/tauri/tauri.conf.json",
    "tauri:diff": "tauri dev -f verge-dev deadlock-detection -c ./backend/tauri/tauri.conf.json",
    "tauri:preview": "pnpm prepare:preview && tauri dev -f verge-dev deadlock-detection -c ./backend/tauri/tauri.preview.conf.json",
    "web:dev": "pnpm --filter=@nyanpasu/nyanpasu dev",
    "web:build": "pnpm --filter=@nyanpasu/nyanpasu build",
    "web:serve": "pnpm --filter=@nyanpasu/nyanpasu preview",
    "web:visualize": "pnpm --filter=@nyanpasu/nyanpasu bundle:visualize",
    "typecheck": "run-s lint:ts",
    "lint": "run-s lint:*",
    "lint:prettier": "prettier --check .",
    "lint:oxlint": "oxlint .",
    "lint:deno": "deno task lint:deno",
    "lint:architecture-ledger": "deno task lint:architecture-ledger",
    "architecture-ledger": "deno task architecture-ledger",
    "lint:styles": "stylelint --cache --allow-empty-input \"**/*.css\"",
    "lint:ts": "pnpm -r --filter './frontend/*' typecheck && pnpm lint:ts:node && pnpm lint:ts:perf && pnpm lint:ts:tests",
    "lint:ts:perf": "tsc --noEmit --project ./frontend/nyanpasu/perf/tsconfig.json",
    "lint:ts:tests": "tsc --noEmit --project tsconfig.test.json",
    "lint:clippy": "cargo clippy --manifest-path ./backend/Cargo.toml --all-targets --all-features",
    "lint:rustfmt": "cargo fmt --manifest-path ./backend/Cargo.toml --all -- --check",
    "knip": "knip",
    "test": "run-p test:scripts test:backend test:frontend",
    "test:architecture-ledger": "deno task test:architecture-ledger",
    "test:release": "deno task test:release",
    "test:updater": "deno task test:updater",
    "test:windows-bundle": "deno task test:windows-bundle",
    "test:linux-release": "deno task test:linux-release",
    "test:scripts": "deno task test:scripts",
    "test:backend": "cargo test --manifest-path ./backend/Cargo.toml --all-features",
    "test:frontend": "vitest run",
    "fmt": "run-p fmt:*",
    "fmt:deno": "deno task fmt:scripts",
    "fmt:backend": "cargo fmt --manifest-path ./backend/Cargo.toml --all",
    "fmt:prettier": "prettier --write .",
    "fmt:oxlint": "oxlint --fix .",
    "updater": "deno task updater",
    "updater:nightly": "deno task updater:nightly",
    "publish": "deno task publish",
    "portable": "deno task portable",
    "generate:git-info": "deno task generate:git-info",
    "generate:data-slots": "deno task generate:data-slots",
    "generate:manifest": "deno task generate:manifest",
    "generate:manifest:latest-version": "deno task generate:manifest:latest-version",
    "prepare": "husky",
    "prepare:nightly": "deno task prepare:nightly",
    "prepare:release": "deno task prepare:release",
    "prepare:preview": "deno task prepare:preview",
    "prepare:check": "deno task prepare:check",
    "lint:frontend-boundaries": "deno task lint:frontend-boundaries",
    "lint:ts:node": "tsc --noEmit --project ./frontend/nyanpasu/tsconfig.node.json"
  },
  "dependencies": {
    "husky": "9.1.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.19.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.3",
    "knip": "6.39.0",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.86.0",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prettier-plugin-toml": "3.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-order": "8.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite-plugin-svgr": "5.2.0",
    "vitest-browser-react": "2.3.0",
    "@tanstack/react-query": "5.104.1",
    "@tauri-apps/api": "2.12.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "react-use": "17.6.1"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.21.0"
  }
}
