# The WebUI is Nyanpasu's main interface: nyanpasu-server serves it on this
# address and LuCI frames it (Services -> Nyanpasu). The port is plain HTTP and
# reachable from the LAN; the default firewall's WAN input reject keeps it off
# the WAN. An empty webui_listen turns the WebUI (and its port) off.
config nyanpasu 'main'
	option webui_listen '0.0.0.0:7899'
	option webui_dir '/usr/share/nyanpasu/webui'
