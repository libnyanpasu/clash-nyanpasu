{
  "name": "@nyanpasu/monorepo",
  "version": "2.0.0-rc.2",
  "repository": "https://github.com/libnyanpasu/clash-nyanpasu.git",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "run-p tauri:dev",
    "dev:diff": "run-p tauri:diff",
    "build": "tauri build",
    "build:packages": "pnpm -r --filter './frontend/*' --filter '!@nyanpasu/nyanpasu' typecheck",
    "build:release": "run-s build:packages build",
    "build:debug": "tauri build -f verge-dev deadlock-detection -d -c \"{ \\\"tauri\\\" : { \\\"updater\\\": { \\\"active\\\": false } }} \"",
    "build:nightly": "tauri build -f nightly -c ./backend/tauri/tauri.nightly.conf.json",
    "build:profiling": "tauri build --no-bundle -- --profile profiling",
    "tauri": "tauri",
    "tauri:dev": "tauri dev -c ./backend/tauri/tauri.conf.json",
    "tauri:diff": "tauri dev -f verge-dev deadlock-detection -c ./backend/tauri/tauri.conf.json",
    "tauri:preview": "pnpm prepare:preview && tauri dev -f verge-dev deadlock-detection -c ./backend/tauri/tauri.preview.conf.json",
    "web:dev": "pnpm --filter=@nyanpasu/nyanpasu dev",
    "web:build": "pnpm --filter=@nyanpasu/nyanpasu build",
    "web:serve": "pnpm --filter=@nyanpasu/nyanpasu preview",
    "web:visualize": "pnpm --filter=@nyanpasu/nyanpasu bundle:visualize",
    "typecheck": "run-s lint:ts",
    "lint": "run-s lint:*",
    "lint:prettier": "prettier --check .",
    "lint:oxlint": "oxlint .",
    "lint:architecture-ledger": "node scripts/src/architecture-ledger/main.ts --mode=gate",
    "lint:backend-boundaries": "node scripts/src/architecture-ledger/backend-boundaries.ts",
    "architecture-ledger": "node scripts/src/architecture-ledger/main.ts --mode=report",
    "lint:styles": "stylelint --cache --allow-empty-input \"**/*.css\"",
    "lint:ts": "pnpm -r --filter './frontend/*' typecheck && pnpm lint:ts:node && pnpm lint:ts:scripts && pnpm lint:ts:perf && pnpm lint:ts:tests",
    "lint:ts:perf": "tsc --noEmit --project ./frontend/nyanpasu/perf/tsconfig.json",
    "lint:ts:tests": "tsc --noEmit --project tsconfig.test.json",
    "lint:clippy": "cargo clippy --manifest-path ./backend/Cargo.toml --all-targets --all-features",
    "lint:rustfmt": "cargo fmt --manifest-path ./backend/Cargo.toml --all -- --check",
    "knip": "knip",
    "test": "run-p --continue-on-error test:scripts test:backend test:frontend",
    "test:architecture-ledger": "node --test scripts/src/architecture-ledger/architecture-ledger_test.ts",
    "test:release": "node --test scripts/src/release/check-nightly-changes_test.ts scripts/src/release/publish_test.ts scripts/src/release/prepare-release_test.ts scripts/src/release/finalize-linux-release_test.ts scripts/src/release/finalize-macos-dmg_test.ts scripts/src/updater/release-channel_test.ts",
    "test:updater": "node --test scripts/src/updater/updater-platforms_test.ts scripts/src/updater/sourceforge-mirrors_test.ts scripts/src/updater/release-channel_test.ts",
    "test:windows-bundle": "node --test scripts/src/release/windows-bundle_test.ts",
    "test:linux-release": "node --test scripts/src/release/finalize-linux-release_test.ts",
    "test:scripts": "node --test \"scripts/src/**/*_test.ts\"",
    "test:backend": "cargo test --manifest-path ./backend/Cargo.toml --all-features",
    "test:frontend": "vitest run",
    "fmt": "run-p fmt:*",
    "fmt:backend": "cargo fmt --manifest-path ./backend/Cargo.toml --all",
    "fmt:prettier": "prettier --write .",
    "fmt:oxlint": "oxlint --fix .",
    "updater": "node scripts/src/updater/updater.ts",
    "updater:nightly": "node scripts/src/updater/updater-nightly.ts",
    "publish": "node scripts/src/release/publish.ts",
    "portable": "node scripts/src/release/portable.ts",
    "generate:git-info": "node scripts/src/generate/generate-git-info.ts",
    "generate:data-slots": "node scripts/src/generate/extract-data-slots.ts",
    "generate:credits": "node scripts/src/generate/credits/generate-credits.ts",
    "generate:manifest": "pnpm run generate:manifest:latest-version",
    "generate:manifest:latest-version": "node scripts/src/manifest/generate-latest-version.ts",
    "prepare": "husky",
    "prepare:nightly": "node scripts/src/release/prepare-nightly.ts",
    "prepare:release": "node scripts/src/release/prepare-release.ts",
    "prepare:preview": "node scripts/src/release/prepare-preview.ts",
    "prepare:check": "node scripts/src/prepare/check.ts",
    "lint:frontend-boundaries": "node scripts/src/frontend/main.ts",
    "lint:ts:node": "tsc --noEmit --project ./frontend/nyanpasu/tsconfig.node.json",
    "test:manifest": "node --test scripts/src/manifest/*_test.ts scripts/src/prepare/binaries_test.ts scripts/src/prepare/resources_test.ts",
    "finalize:macos-dmg": "node scripts/src/release/finalize-macos-dmg.ts",
    "test:backend-musl": "node scripts/src/testing/test-backend-musl.ts",
    "bench:ab": "node scripts/src/benchmark/bench-ab.ts",
    "bench:profile": "node scripts/src/benchmark/profile-report.ts",
    "bench:trace": "node scripts/src/benchmark/trace-report.ts",
    "upload-macos-updater": "node scripts/src/artifacts/upload-macos-updater.ts",
    "telegram:publish": "node scripts/src/artifacts/publish-telegram.ts",
    "telegram-notify": "node scripts/src/notifications/telegram-notify.ts",
    "build-cache": "node scripts/src/artifacts/build-cache.ts",
    "upload-build-artifacts": "node scripts/src/artifacts/upload-build-artifacts.ts",
    "verify:archive-uploads": "node scripts/src/artifacts/verify-upload-reports.ts",
    "prepare:publication-manifest": "node scripts/src/artifacts/prepare-publish-manifest.ts",
    "prepare:central-publication": "node scripts/src/artifacts/prepare-central-publication.ts",
    "archive:publish": "node scripts/src/artifacts/publish-internet-archive.ts",
    "archive:verify": "node scripts/src/artifacts/internet-archive-upload.ts --verify-only",
    "sourceforge:upload": "node scripts/src/artifacts/publish-sourceforge.ts",
    "sourceforge:web-publish": "node scripts/src/artifacts/publish-sourceforge-web.ts",
    "sourceforge:cleanup": "node scripts/src/artifacts/cleanup-sourceforge-nightly.ts",
    "sourceforge:verify": "node scripts/src/artifacts/verify-sourceforge-mirror.ts",
    "archive:verify-reports": "node scripts/src/artifacts/verify-ia-reports.ts",
    "generate:topology-map": "node scripts/src/generate/generate-topology-map.ts",
    "lint:credits": "node scripts/src/generate/credits/generate-credits.ts --check",
    "check:nightly-changes": "node scripts/src/release/check-nightly-changes.ts",
    "check:changed-parts": "node scripts/src/ci/changed-parts.ts",
    "sign-nightly-updater": "node scripts/src/release/sign-nightly-updater.ts",
    "finalize-linux-release": "node scripts/src/release/finalize-linux-release.ts",
    "test:http-ui": "node scripts/src/testing/test-http-ui.ts",
    "storage:preflight": "node scripts/src/artifacts/storage-preflight.ts",
    "recover:central-publication": "node scripts/src/artifacts/recover-central-publication.ts",
    "storage:recover": "node scripts/src/artifacts/recover-storage.ts",
    "archive:register": "node scripts/src/artifacts/internet-archive-upload.ts --register-only",
    "lint:ts:scripts": "tsc --noEmit --project ./scripts/tsconfig.json"
  },
  "dependencies": {
    "husky": "9.1.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "knip": "6.42.1",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.4",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "postcss": "8.5.31",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prettier-plugin-toml": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recess-order": "7.8.2",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-order": "8.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite-plugin-svgr": "5.2.0",
    "vitest-browser-react": "2.3.0",
    "@tanstack/react-query": "5.104.5",
    "@tauri-apps/api": "2.12.4",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "react-use": "17.6.1"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.22.1"
  }
}
