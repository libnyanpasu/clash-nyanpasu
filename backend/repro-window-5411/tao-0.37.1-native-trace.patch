@@ -33,6 +33,48 @@ use windows::{
   },
 };

+pub(super) fn trace_geometry_args(args: std::fmt::Arguments<'_>) {
+  use std::io::Write;
+  // Diagnostic output must not panic across a Win32 callback if the pipe closes.
+  let _ = writeln!(std::io::stderr().lock(), "[tao-native-5411] {args}");
+}
+
+pub(super) fn trace_geometry(window: HWND, stage: &str) {
+  unsafe {
+    let mut outer = RECT::default();
+    let mut client = RECT::default();
+    let outer = GetWindowRect(window, &mut outer).ok().map(|_| outer);
+    let client = GetClientRect(window, &mut client).ok().map(|_| client);
+    trace_geometry_args(format_args!(
+      "hwnd={window:?} stage={stage} userdata={} style={:#x} ex_style={:#x} outer={outer:?} client={client:?}",
+      GetWindowLongPtrW(window, GWL_USERDATA),
+      GetWindowLongW(window, GWL_STYLE) as u32,
+      GetWindowLongW(window, GWL_EXSTYLE) as u32,
+    ));
+  }
+}
+
+// FALSE supplies a RECT; TRUE supplies NCCALCSIZE_PARAMS. Only observe the
+// proposed/new client rectangle, without changing either form or the old rects.
+pub(super) unsafe fn trace_nccalc(
+  window: HWND,
+  wparam: WPARAM,
+  lparam: LPARAM,
+  stage: &str,
+  result: Option<LRESULT>,
+) {
+  let rect = if wparam.0 == 0 {
+    *(lparam.0 as *const RECT)
+  } else {
+    (*(lparam.0 as *const NCCALCSIZE_PARAMS)).rgrc[0]
+  };
+  trace_geometry_args(format_args!(
+    "hwnd={window:?} message=WM_NCCALCSIZE stage={stage} wparam={} userdata={} rect={rect:?} result={result:?}",
+    wparam.0,
+    GetWindowLongPtrW(window, GWL_USERDATA),
+  ));
+}
